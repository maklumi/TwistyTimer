        <item name="colorMainGradientStart">#1959ff</item>
        <item name="colorMainGradientEnd">#3b12ff</item>
        <item name="colorAccent">@color/md_amber_A200</item>
        <item name="colorPrimaryDark">?attr/colorMainGradientStart</item>

        <!-- MaterialDrawer 9.x Theme Attributes -->
        <item name="materialDrawerStyle">@style/Widget.MaterialDrawerStyle</item>
        <item name="materialDrawerBackground">?attr/colorSurface</item>
        <item name="materialDrawerDividerColor">?attr/colorOutlineVariant</item>
        <item name="materialDrawerInsetForeground">?attr/colorSurface</item>
        <item name="materialDrawerPrimaryIcon">?attr/colorOnSurfaceVariant</item>
        <item name="materialDrawerPrimaryText">?attr/colorOnSurface</item>
        <item name="materialDrawerSecondaryIcon">?attr/colorOnSurfaceVariant</item>
        <item name="materialDrawerSecondaryText">?attr/colorOnSurfaceVariant</item>
        <item name="materialDrawerSelectedBackgroundColor">?attr/colorSecondaryContainer</item>

        <item name="materialAlertDialogTheme">@style/MyCustomAlertDialogTheme</item>
    </style>

    <style name="BaseDefaultTheme.Launcher" parent="BaseDefaultTheme">
        <item name="android:windowBackground">@drawable/background_gradient</item>
        <item name="colorPrimaryDark">#0062ff</item>
    </style>

    <style name="SettingsTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_blue_A700</item>
        <item name="colorPrimaryDark">@color/md_blue_A700</item>
        <item name="colorAccent">@color/md_blue_A700</item>
        <item name="android:fontFamily">?defaultFontFamily</item>
        <item name="colorSurfaceVariant">@color/md_indigo_200</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="MyCustomAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Material3.BodyLarge</item>
        <item name="colorPrimary">#2196F3</item>
    </style>

    <!--
    "DefaultTheme" may be defined differently in "values-v21/styles.xml" before being inherited
    by the "Base<Color>Theme" styles, which extend "DefaultTheme", not "BaseDefaultTheme".
    -->
    <style name="DefaultTheme" parent="BaseDefaultTheme" />

    <style name="OverlayTheme" />

    <!--
     An overlay that disables the timer colored background
     -->
    <style name="SettingsPreferenceTheme" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceCategoryStyle">@style/PreferenceCategoryStyle</item>
    </style>

    <style name="PreferenceCategoryStyle" parent="Preference.Category">
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">true</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="DefaultTheme.Overflow" parent="DefaultTheme">
        <item name="android:src">@drawable/ic_outline_more_vert_18px</item>
        <item name="android:tint">?attr/colorOnSurface</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="BaseDefaultTheme.ActionMode" parent="BaseDefaultTheme">
        <item name="android:actionModeStyle">@style/ActionModeStyle.Custom</item>
    </style>

    <style name="ActionModeStyle.Custom" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

