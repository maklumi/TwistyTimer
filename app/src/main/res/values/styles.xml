        <item name="colorTertiary">@color/md_blue_A700</item>
        <item name="colorOnTertiary">#FFFFFF</item>
        <item name="colorTertiaryContainer">#FFEF8F</item>
        <item name="colorSecondary">#B3FFFFFF</item>
        <item name="colorSecondaryContainer">#444444</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#B3FFFFFF</item>
        <item name="colorSurfaceContainer">#1F1F1F</item>
        <item name="colorSurfaceVariant">#4D4D4D</item>
        <item name="colorOutline">#938F99</item>
        <item name="colorOutlineVariant">#444444</item>
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="preferenceTheme">@style/SettingsPreferenceTheme</item>

        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Material3.BottomSheetDialog</item>

        <item name="actionBarSize">54dp</item>
        <item name="actionBarPadding">70dp</item>
        <item name="tabBarSize">40dp</item>
        <item name="tabBarPadding">48dp</item>
        <item name="statTextStyle">@style/StatTextStyle</item>

        <item name="qaButtonSize">48dp</item>

        <item name="defaultFontFamily">@font/quicksand_medium</item>
