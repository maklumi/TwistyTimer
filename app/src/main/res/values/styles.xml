    <style name="AppBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/outline_background_card_top</item>
    </style>

    <style name="StatTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:gravity">right</item>
        <item name="android:textSize">13.3sp</item>
        <item name="android:background">?attr/colorSurfaceContainer</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="StatTabTextStyle">
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13.3sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="DialogItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="ActionModeStyle" parent="Base.Widget.AppCompat.ActionMode">
        <item name="android:background">?attr/colorSurface</item>
        <item name="actionModeBackground">?attr/colorSurface</item>
        <item name="android:backgroundSplit">?attr/colorSurface</item>
        <item name="android:titleTextStyle">@style/Toolbar.TitleText</item>
        <item name="android:subtitleTextStyle">@style/Toolbar.SubtitleText</item>
        <item name="android:actionModeCloseDrawable">@drawable/ic_clear_black_24dp</item>
        <item name="actionModeCloseDrawable">@drawable/ic_clear_black_24dp</item>
    </style>

    <style name="DrawerArrowStyle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="spinBars">true</item>
        <item name="color">@android:color/white</item>
    </style>

    <style name="SheetListItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:alpha">0.8</item>
    </style>

    <style name="DialogExportImportActions">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">8dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Toolbar.TitleText" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Toolbar.SubtitleText" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- "ToolBarStyle" is defined differently for v21. -->
    <style name="BaseToolBarStyle">
        <item name="popupTheme">@style/ThemeOverlay.Material3.MaterialAlertDialog</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
    </style>

    <style name="ToolBarStyle" parent="BaseToolBarStyle" />

    <!-- "Widget.Tarefa.Header.Spinner" is defined differently for v21. -->
    <style name="Base.Widget.Tarefa.Header.Spinner" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="android:background">?android:selectableItemBackground</item>
        <item name="android:dropDownSelector">?android:selectableItemBackground</item>
        <item name="android:divider">@null</item>
    </style>

    <style name="Widget.Tarefa.Header.Spinner" parent="Base.Widget.Tarefa.Header.Spinner" />

    <style name="AppAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">?attr/colorSurfaceContainer</item>
        <item name="colorOnSurface">?attr/colorOnSurface</item>
        <item name="colorPrimary">?attr/colorPrimary</item>
    </style>

    <style name="HeaderSwitch">
        <!-- Active thumb color & Active track color(30% transparency) -->
        <item name="colorControlActivated">@color/white_text</item>
        <!-- Inactive thumb color -->
        <item name="colorSwitchThumbNormal">@color/primaryColor</item>
        <!-- Inactive track color(30% transparency) -->
        <item name="android:colorForeground">@color/black_text</item>
    </style>

    <style name="DefaultTheme.NoActionBar" parent="DefaultTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="DefaultTheme.AppBarOverlay" parent="ThemeOverlay.Material3.DayNight.BottomSheetDialog" />

    <style name="DefaultTheme.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

</resources>
