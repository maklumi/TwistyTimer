<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="BaseTwistyTheme">
        <attr format="color" name="colorMainGradientStart"/>
        <attr format="color" name="colorMainGradientEnd"/>

        <attr format="reference" name="statTextStyle"/>
        <attr format="reference" name="defaultFontFamily"/>

        <attr format="dimension" name="tabBarSize"/>
        <attr format="dimension" name="tabBarPadding"/>
        <attr format="dimension" name="actionBarPadding"/>
        <attr format="dimension" name="qaButtonSize"/>
    </declare-styleable>

    <declare-styleable name="Cube">
        <attr name="cube_corner_radius" format="dimension"/>
        <attr name="cube_sticker_corner_radius" format="dimension"/>
    </declare-styleable>

    <declare-styleable name="RippleBackgroundView">
        <attr name="rb_color" format="color"/>
        <attr name="rb_strokeWidth" format="dimension"/>
        <attr name="rb_radius" format="dimension"/>
        <attr name="rb_duration" format="integer"/>
        <attr name="rb_rippleAmount" format="integer"/>
        <attr name="rb_scale" format="float"/>
        <attr name="rb_type" format="enum">
            <enum name="fillRipple" value="0"/>
            <enum name="strokeRipple" value="1"/>
        </attr>
    </declare-styleable>
    <attr name="colorOnSurface" format="color" />
    <attr name="colorSurfaceContainer" format="color" />
    <attr name="colorTertiary" format="color" />
    <attr name="colorSurface" format="color" />
    <attr name="colorSurfaceVariant" format="color" />
    <attr name="colorOutline" format="color" />
    <attr name="colorOutlineVariant" format="color" />
    <attr name="colorOnSurfaceVariant" format="color" />
    <attr name="colorOnSecondaryContainer" format="color" />
    <attr name="colorOnTertiaryContainer" format="color" />

</resources>
