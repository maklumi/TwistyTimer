<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@+id/card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginLeft="6dp"
    android:layout_marginRight="6dp"
    android:layout_marginTop="0dp"
    app:cardCornerRadius="8dp"
    app:cardPreventCornerOverlap="false"
    app:cardBackgroundColor="?attr/colorSurfaceContainer">

    <RelativeLayout
        android:id="@+id/item_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            tools:text="2026, 15 Jun"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/penaltyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_toEndOf="@id/date"
            android:padding="4dp"
            android:textColor="@color/red_material"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="+2" />

        <TextView
            android:id="@+id/timeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/date"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:ellipsize="end"
            android:fontFamily="@font/lato_bold"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:paddingBottom="4dp"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="1:26.95" />

        <ImageView
            android:id="@+id/commentIcon"
            app:tint="?attr/colorOnSurface"
            tools:visibility="visible"
            android:alpha="0.80"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="16dp"
            app:srcCompat="@drawable/ic_outline_insert_comment_24px"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="4dp"
            android:paddingBottom="4dp"/>

        <ImageView
            android:id="@+id/selectedIndicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_outline_done_outline_16px"
            app:tint="?attr/colorPrimary"
            tools:visibility="visible" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>